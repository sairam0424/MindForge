node_modules/
scratch-pad/
# Upstream source repo (its own git repo) — content is ported into subagents/
awesome-claude-code-subagents/
# ECC donor repo (its own git repo) — capabilities are ported into MindForge per
# the feat/ecc-upgrade plan; the donor itself must never be committed.
ECC/
# Serena MCP project cache (generated)
.serena/
.env
.env.*
*.log
.DS_Store
Thumbs.db
dist/
# ...but the MCP server's COMPILED dist must ship inside the plugin (a github-source
# plugin install copies committed files; an unbuilt dist would mean no MCP server).
# This is the generated, committed bundle — distinct from mcp-server/dist (build artifact).
!plugins/mindforge/mcp/dist/
!plugins/mindforge/mcp/dist/**
build/
coverage/
.nyc_output/
*.local

*.key
*.pem

# Security scan reports (may contain vulnerability details)
# Remove from this list if your repo is private and team visibility is desired
# .planning/SECURITY-SCAN-*.md
# .planning/phases/*/SECURITY-REVIEW-*.md

# Uncomment the above ONLY if this is a public repository.
# Private repos: keep scan reports for team review and audit history.

# MindForge v2 — knowledge graph (contains project-specific insights)
# NOTE: Teams may CHOOSE to commit .mindforge/memory/ for shared team memory
# The decision depends on sensitivity of decisions and patterns stored.
# By default: gitignored. Opt-in to git tracking by removing these lines.
.mindforge/memory/*.jsonl

temp-test-install/
tests/tmp-graph/
# Husky
.husky/_

.agents/
.planning/history/
.planning/TEMPORAL-TEST.md
MIND-FORGE-V6-ENTERPRISE-PROPOSAL.md
.planning/RISK-AUDIT.jsonl
ROADMAP_V7.md

.mindforge/*.db
.mindforge/*.db-journal
.mindforge/*.db-wal
.mindforge/*.db-shm
# Transient atomic-write temp files (UC-09 durable writes: tmp + rename).
# Scoped to the only dirs that actually produce them (.mindforge/, .planning/)
# instead of an over-broad unanchored *.tmp.[0-9]* that could match anything.
.mindforge/*.tmp.*
.planning/*.tmp.*
# COST-01: the ledger purge rewrites .mindforge/metrics/token-usage.jsonl, so its temp
# file is TWO levels deep and the single-level globs above do not match it.
.mindforge/**/*.tmp.*
# Advisory lock files (LOCK-01 fail-closed append lock). Unlinked in finally, but a
# hard kill leaves one behind until the 10s stale reclaim — never commit them.
.planning/**/*.jsonl.lock
.mindforge/**/*.jsonl.lock
# VectorHub now takes the same lock around the DB commit, so the lockfile sits beside
# celestial.db rather than beside a .jsonl and the rules above do not cover it.
.mindforge/*.db.lock
.mindforge/**/*.db.lock
# Conflict sidecars written when VectorHub refuses to clobber another process's write.
# Each one is a FULL database copy — 147KB+ of trace and knowledge content — so an
# unignored sidecar is both a large binary and a content leak waiting for `git add -A`.
# They are recovery artifacts for the operator to reconcile, never repository state.
.mindforge/*.conflict.*
.mindforge/**/*.conflict.*
.mindforge/memory/sync-manifest.json
# SRE shadow mirrors. bin/autonomous/auto-runner.js:217 constructs ShadowMirror with no options, so
# bin/sre/shadow-mirror.js:29 falls back to `process.cwd()/.mindforge/mirrors` — a FULL git-worktree
# replica of the project. Measured: one run left a 49-entry copy of this repo under
# .mindforge/mirrors/mirror-sre-<id>/, including its own plugins/mindforge/.mcp.json. Untracked and
# unignored, so a single `git add -A` after an incident-remediation run commits the whole tree twice.
#
# NOTE this does NOT stop `eslint .` from walking a stray mirror: eslint flat config does not read
# .gitignore, and a mirrored copy of .mindforge/dynamic-workflows/scripts/ produces parse errors that
# turn `npm run lint` red. Same human decision as `.claude/worktrees/**` — both need an ignore entry in
# the protected eslint.config.mjs.
.mindforge/mirrors/
# Runtime auth tokens (generated at server startup, never commit)
.mindforge/.dashboard-token
.mindforge/.browser-daemon-token
*.mfb
.npm-cache/

.npmrc

# Runtime-generated artifacts (produced by tests and execution)
.planning/AUDIT.jsonl
.planning/ROI.jsonl
.planning/TEST_AUDIT.jsonl
.planning/decisions/SRE-*.md
.planning/decisions/ADR-*.md
.planning/memories/
.mindforge/audit/AUDIT.jsonl
.mindforge/audit/manifests/
.mindforge/metrics/token-usage.jsonl
.gstack/

# External agent-tooling artifacts (claude-flow / ruflo / hermes / agentdb).
# Not MindForge's, but they materialise at the repo root and in mcp-server/ whenever those
# tools run, and this is a PUBLIC repository — an unguarded `git add -A` would publish a
# local vector database. files[] already keeps them out of the npm tarball; this keeps them
# out of git.
.claude-flow/
.swarm/
hermes-agent/
agentdb.rvf
agentdb.rvf.lock
ruvector.db
**/ruvector.db
**/.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version
# Agent worktrees. Isolated-worktree subagents check out FULL COPIES of this repo here — three of
# them measured 50+ entries each — so a single `git add -A` during a run would commit the whole tree
# several times over. They are transient and removed when the run ends.
#
# Note this does NOT stop repo-wide tooling from walking them: `npm run lint` is `eslint .`, and with
# worktrees present it went from 193 warnings / 0 errors to 888 problems / 105 errors, all from other
# agents' in-progress code. eslint flat config does not read .gitignore, and eslint.config.mjs is
# protected against agent edits by design, so excluding it there is a human decision.
.claude/worktrees/
