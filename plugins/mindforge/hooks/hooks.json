{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-with-flags.js\" mindforge-check-update \"${CLAUDE_PLUGIN_ROOT}/scripts/mindforge-check-update.js\" minimal,standard,strict"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-with-flags.js\" mindforge-session-init \"${CLAUDE_PLUGIN_ROOT}/scripts/mindforge-session-init_extended.js\" minimal,standard,strict"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-with-flags.js\" mindforge-context-monitor \"${CLAUDE_PLUGIN_ROOT}/scripts/mindforge-context-monitor.js\" standard,strict",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-with-flags.js\" mindforge-prompt-guard \"${CLAUDE_PLUGIN_ROOT}/scripts/mindforge-prompt-guard.js\" standard,strict",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-with-flags.js\" mindforge-config-protection \"${CLAUDE_PLUGIN_ROOT}/scripts/mindforge-config-protection.js\" minimal,standard,strict",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-with-flags.js\" trust-gate \"${CLAUDE_PLUGIN_ROOT}/scripts/security/trust-gate-hook.js\" minimal,standard,strict",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-with-flags.js\" mindforge-block-no-verify \"${CLAUDE_PLUGIN_ROOT}/scripts/mindforge-block-no-verify.js\" minimal,standard,strict",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
